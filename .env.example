# Required for live SERV Reasoning (server-only). Without it every SERV step runs
# its deterministic fallback and the app keeps working (trace shows "Fallback").
# Get a key at https://console.openserv.ai - never prefix with NEXT_PUBLIC_.
SERV_API_KEY=

# Model routing (both models are in the SERV catalog). Defaults:
#   small = gpt-5.4-mini -> intent parsing, risk notes + rules cross-check,
#                           independent verifier, decision agent
#   large = gpt-5.4      -> ranking + investment memo
SERV_MODEL_SMALL=gpt-5.4-mini
SERV_MODEL_LARGE=gpt-5.4

# Optional price table override for the cost ESTIMATE shown in the trace
# (USD per 1M tokens). Defaults are OpenAI list prices; SERV billing may differ.
# SERV_PRICES_JSON={"gpt-5.4-mini":{"inputPerMTok":0.75,"outputPerMTok":4.5},"gpt-5.4":{"inputPerMTok":2.5,"outputPerMTok":15}}

# IXS Vault API (public REST/MCP; User-Agent only, no API key required today)
IXS_API_BASE_URL=https://api-v2.ixs.finance
IXS_MCP_URL=https://api-v2.ixs.finance/mcp

# Optional WalletConnect project id (injected MetaMask works without it)
# https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Self-host / Dokploy: stable AES key so Server Action IDs stay consistent across
# rebuilds (base64 of 16/24/32 bytes). Generate: openssl rand -base64 32
# Must be present at build time (embedded in the Next build output).
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
